# ===== Ollama =====
OLLAMA_HOST=http://localhost:11434
MODEL=qwen2.5:3b
# 上下文窗口：资料已做摘要压缩，8192 足够且比 16384 提示处理更快
NUM_CTX=8192
TEMPERATURE=0.2
# 单次 LLM 调用超时秒数：超时后重试一次（联网实测曾单次卡 307s 拖垮任务，30s 上限更早重试）
LLM_TIMEOUT=30

# ===== 搜索 =====
# local: 检索本地文档文件夹（无需 key）| tavily: 真实联网搜索
SEARCH_PROVIDER=local
# local 模式的文档文件夹（相对路径基于项目根目录），支持 md/txt/pdf/docx，可含子目录
LOCAL_DOCS_DIR=data
TAVILY_API_KEY=tvly-你的key

# 博查搜索（国内 AI 搜索，中文召回优于 Tavily）
BOCHA_API_KEY=sk-你的key

# ===== 来源质量 =====
# 权威定向补搜：常规搜索没有权威来源（央视/新华/政府/统计机构）时，
# 额外对该白名单域名做一次定向检索并前置。1=开启（默认）0=关闭
AUTHORITY_PASS=1
# 单次调研最多执行几次权威定向检索（每次多消耗 1 次搜索额度）
AUTHORITY_PASS_BUDGET=3

# ===== 时效偏好 =====
# 发布在最近 N 天内的来源获得小幅加分（**只奖不罚**）。0=关闭，退回纯权威+相关度排序。
# 不能改成"惩罚旧内容"：多数政府一手来源的 URL 不含日期，惩罚旧的会让"日期未知"
# 相对占优，反而把确知较旧的央视/新华网挤出候选（离线回放实测 22 例）。
# 回归验证：python -m eval.freshness
FRESH_DAYS=180
FRESH_BONUS=0.05

# Tavily 检索范围：general=全站召回（默认）| news=只召回新闻站点。
# 实测两者召回几乎不重叠：news 独有央视财经/人民日报，general 独有海关总署/商务部。
# news 下才返回 published_date（general 实测 0/32），但会损失政府站点召回，
# 因此默认 general，发布日期由 URL 内嵌日期兜底（权威域覆盖≈70%）。
TAVILY_TOPIC=general

# ===== 成文后处理 =====
# 跨节去重的相似度阈值：1.0=只去逐字重复，0.85（默认）可抓到"差一个词/换个归因说法"
# 的改述型重复。数字口径不相容的句子一律不判重，调低不会拿不同数据互相覆盖。
DEDUPE_SIMILARITY=0.85

# 缓存模式: record=未命中则真实请求并落盘 | replay=只读缓存（评估回放，未命中报错）| off=不使用缓存
CACHE_MODE=record

# 是否走系统代理（如 Clash）。系统代理不稳时 Tavily 会 SSL 断连/403，默认直连；确需代理改 1
USE_SYSTEM_PROXY=0
